BOT_TOKEN=your_telegram_bot_token
OWNER_TELEGRAM_ID=your_owner_telegram_id
DATABASE_URL=sqlite+aiosqlite:///./planner.db
LOG_LEVEL=INFO
# Enable only in the isolated migrated environment first (Alembic head 0011).
BOOKING_RUNTIME_ENABLED=false
CALENDAR_ENVIRONMENT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/google/oauth/callback
OAUTH_ENCRYPTION_KEY=
WEB_HOST=0.0.0.0
WEB_PORT=8000
BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Планировщик встреч
SMTP_USE_TLS=true
SMTP_USE_SSL=false
